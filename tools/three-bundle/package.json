{
  "name": "lobelab-three-bundle",
  "private": true,
  "description": "Builds the tree-shaken three.js bundle embedded in LobeLab's index.html",
  "scripts": {
    "build": "esbuild entry.js --bundle --minify --format=iife --target=es2018 --legal-comments=inline --outfile=three-lobelab.min.js"
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "three": "0.186.1"
  }
}
